# Dependencies
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches/
!**/.yarn/plugins/
!**/.yarn/releases/
!**/.yarn/versions/

# Framework and build output
**/.next/
**/out/
**/build/
**/dist/
**/coverage/
**/.turbo/
**/.vercel/
**/.netlify/

# Local environment and credentials
**/.env
**/.env.*
!**/.env.example
!**/.env.template
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/secrets/

# Local databases and database sidecar files
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*

# Generated logs, reports, and local exports
**/*.log
**/*-output.txt
**/*_output.txt
**/exports/
**/reports/generated/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# TypeScript and Next.js generated files
**/*.tsbuildinfo
**/next-env.d.ts

# Operating system and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
